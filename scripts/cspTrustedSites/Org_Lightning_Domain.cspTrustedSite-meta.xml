<?xml version="1.0" encoding="UTF-8"?>
<!-- Template, not deployable as is: createScratchOrg.sh fills endpointUrl with the org's Lightning domain and deploys the result from a temporary folder. -->
<CspTrustedSite xmlns="http://soap.sforce.com/2006/04/metadata">
    <context>All</context>
    <description>Lightning domain of this org, so that Agentforce agents can include record links in their responses.</description>
    <endpointUrl>__LIGHTNING_DOMAIN__</endpointUrl>
    <isActive>true</isActive>
    <isApplicableToConnectSrc>true</isApplicableToConnectSrc>
    <isApplicableToFontSrc>false</isApplicableToFontSrc>
    <isApplicableToFrameSrc>false</isApplicableToFrameSrc>
    <isApplicableToImgSrc>false</isApplicableToImgSrc>
    <isApplicableToMediaSrc>false</isApplicableToMediaSrc>
    <isApplicableToStyleSrc>false</isApplicableToStyleSrc>
</CspTrustedSite>
