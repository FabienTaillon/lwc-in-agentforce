{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/text",
              "attributes": {
                "text": "Restaurants found",
                "variant": "h3",
                "weight": "semibold"
              }
            },
            {
              "definition": "tile/container",
              "meta": {
                "forEach": "{!$attrs.restaurants}",
                "forItem": "$restaurant"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center",
                        "justify": "between",
                        "isWrapped": true
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$restaurant.name}",
                            "variant": "h3",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/badge",
                          "attributes": {
                            "label": "{!$restaurant.priceRange}",
                            "variant": "secondary"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/icon",
                          "attributes": {
                            "name": "star",
                            "size": "sm",
                            "color": "warning",
                            "alt": "Michelin stars"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$restaurant.stars}",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Michelin star(s)",
                            "variant": "caption",
                            "color": "muted"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Cuisine",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$restaurant.cuisine}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Book a table",
                        "variant": "primary",
                        "iconName": "calendar",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "Book a table at {!$restaurant.name} (restaurant Id {!$restaurant.id})"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
